# Copy to .env and fill in before running locally.

# Firestore (works on anc-fleet-hackathon, which you own)
GCP_PROJECT_ID=anc-fleet-hackathon

# Gemini via direct API key (Google AI Studio free tier) -- NOT Vertex AI.
# Get a key at https://aistudio.google.com -- this path does not require
# GCP billing verification, unlike Vertex AI.
GEMINI_API_KEY=your-api-key-here

# Data source: "synthetic" (default, NDHS-shaped demo data) or "cliniqbridge" (live FHIR)
ANC_FLEET_SOURCE_MODE=synthetic
CLINIQBRIDGE_BASE_URL=https://cliniqbridge.onrender.com

# Action agent: keep true until you're ready to place real calls/SMS via SentinelCall
ANC_FLEET_DRY_RUN=true
SENTINELCALL_BASE_URL=